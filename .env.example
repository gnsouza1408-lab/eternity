# Copie para .env e preencha. Nunca commite o .env.
# Variáveis VITE_* vão para o bundle do navegador: só valores públicos.

# --- Front (públicas) ---
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# --- Servidor (/api) e scripts (secretas) ---
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
MP_ACCESS_TOKEN=APP_USR-...
# Assinatura secreta do webhook (painel do Mercado Pago > Webhooks)
MP_WEBHOOK_SECRET=

# Opcional: origens permitidas no CORS, separadas por vírgula (padrão: eternity.dev.br e www)
# ALLOWED_ORIGINS=https://eternity.dev.br,https://www.eternity.dev.br

# Cron da Vercel (/api/keepalive): texto aleatório longo, só em Production
CRON_SECRET=

# Assistente de mensagem (/api/gerar-mensagem): só servidor, nunca VITE_*
ANTHROPIC_API_KEY=
