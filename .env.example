# Copie para .env (local) ou cadastre na Vercel (Project Settings > Environment Variables).
# Nunca commite o .env. Aqui só ficam placeholders, nunca valores reais.
# Variáveis VITE_* vão para o bundle do navegador: só valores públicos.

# ---------------------------------------------------------------------------
# Front-end (públicas, lidas pelo Vite em src/lib/supabaseClient.js)
# ---------------------------------------------------------------------------

# URL do projeto Supabase (Project Settings > API). Também é usada como fallback por /api e scripts.
VITE_SUPABASE_URL=https://<ref>.supabase.co
# Chave publicável (anon/publishable) do Supabase. É pública, e o acesso aos dados é limitado pelo RLS.
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# ---------------------------------------------------------------------------
# Servidor (/api) e scripts de manutenção: secretas, nunca com prefixo VITE_
# ---------------------------------------------------------------------------

# (Opcional) URL do Supabase só para o servidor; se vazia, usa VITE_SUPABASE_URL.
# SUPABASE_URL=https://<ref>.supabase.co
# Chave secreta (service role) do Supabase: acesso total ao banco, ignora o RLS. Também é a semente do hash de IP do limite do assistente.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Access token da conta do Mercado Pago (Credenciais de produção), usado para criar e consultar pagamentos PIX.
MP_ACCESS_TOKEN=APP_USR-...
# Assinatura secreta do webhook, usada para validar as notificações (painel do Mercado Pago > Webhooks).
MP_WEBHOOK_SECRET=

# Chave da API da Anthropic, usada pelo assistente de mensagem em /api/gerar-mensagem.
ANTHROPIC_API_KEY=sk-ant-...

# Segredo do cron da Vercel que chama /api/keepalive (texto aleatório longo; defina só em Production).
CRON_SECRET=

# (Opcional) Origens permitidas no CORS, separadas por vírgula; substitui a lista padrão: eternity.dev.br e www.eternity.dev.br.
# ALLOWED_ORIGINS=https://eternity.dev.br,https://www.eternity.dev.br

# Observação: VERCEL_ENV é definida automaticamente pela Vercel (fora de "production" o CORS também aceita localhost;
# em produção só valem as origens acima). Não precisa ser cadastrada.
